# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://events_user:events_password@localhost:15432/eventia"

# Autenticación (mínimo 32 caracteres cada uno)
BETTER_AUTH_SECRET="genera-un-string-aleatorio-de-al-menos-32-caracteres"
TICKET_SIGNING_KEY="genera-otro-string-aleatorio-de-al-menos-32-caracteres"
# Orígenes extra de better-auth (preview deploys). Separados por coma. Nunca uses Host spoofable.
# BETTER_AUTH_TRUSTED_ORIGINS="https://tu-preview.vercel.app"

# Correo (SMTP) — Mailtrap sandbox para desarrollo
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="tu-usuario-mailtrap"
SMTP_PASS="tu-password-mailtrap"
MAIL_FROM_EMAIL="noreply@tudominio.com"
MAIL_FROM_NAME="Evora"

# Pusher (WebSockets)
PUSHER_APP_ID="tu-app-id"
PUSHER_SECRET="tu-secret"
NEXT_PUBLIC_PUSHER_KEY="tu-app-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Uploadthing (archivos e imágenes)
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_TOKEN=""
NEXT_PUBLIC_UPLOADTHING_APP_ID="tu-app-id"

# Culqi (pasarela de pago — plan Pro+)
# CULQI_SECRET_KEY="sk_test_..."
# Preferir HMAC-SHA256 del body en x-culqi-signature, o URL ?token=SECRET. Header=secret sigue soportado (legacy).
# CULQI_WEBHOOK_SECRET="whsec_..."
# NEXT_PUBLIC_CULQI_PUBLIC_KEY="pk_test_..."
# PLATFORM_FEE_PERCENT=3.5

# Web Push (opcional — genera con: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_SUBJECT="mailto:admin@tudominio.com"

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL="https://tu-instancia.upstash.io"
UPSTASH_REDIS_REST_TOKEN="tu-token"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DOCS_URL="http://localhost:4321"
# Orígenes CORS exactos adicionales para /api/docs/auth (coma-separados)
# DOCS_CORS_ORIGINS="https://docs.tudominio.com"

# Cron (obligatorio en runtime de producción — Vercel lo envía como Bearer en /api/cron/*)
CRON_SECRET="genera-un-string-aleatorio-de-al-menos-16-caracteres"

# Superadmin bootstrap — obligatorio en runtime de producción (/superadmin/register)
PLATFORM_BOOTSTRAP_SECRET="genera-un-string-aleatorio-de-al-menos-16-caracteres"

# Broadcasts — emails por lote (default 8, máx 50)
# BROADCAST_BATCH_SIZE=8

# Producción — correo transaccional (reemplaza Mailtrap)
# Resend: SMTP_HOST="smtp.resend.com" SMTP_PORT=465 SMTP_USER="resend" SMTP_PASS="re_..."
# SendGrid: SMTP_HOST="smtp.sendgrid.net" SMTP_PORT=587 SMTP_USER="apikey" SMTP_PASS="SG...."

# IA Copilot (opcional) — free tier recomendado
# AI_PROVIDER=openrouter → OpenRouter primero; google → Gemini primero
# OpenRouter: models[] nativo máx. 3 por request (el resto se reintenta en otra llamada)
# AI_PROVIDER="openrouter"
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.5-flash"
# GEMINI_FALLBACK_MODEL="gemini-3.1-flash-lite"
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL="qwen/qwen3-next-80b-a3b-instruct:free"
# OPENROUTER_FALLBACK_MODELS="google/gemma-4-31b-it:free,openai/gpt-oss-20b:free,nvidia/nemotron-3-nano-30b-a3b:free,meta-llama/llama-3.3-70b-instruct:free,openrouter/free"
