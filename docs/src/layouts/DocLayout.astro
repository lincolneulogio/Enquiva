---
import { ViewTransitions } from "astro:transitions";
import type { MarkdownLayoutProps } from "astro";
import "../styles/global.css";
import {
  BookOpen,
  User,
  Calendar,
  Settings,
  Cpu,
  Sparkles,
  Search,
  Sun,
  Moon,
  ChevronLeft,
  ChevronRight,
  ChevronUp,
  HelpCircle,
  Video,
  Database,
  Shield,
  Activity,
  History,
  LifeBuoy,
  TerminalSquare,
  Rocket,
  Menu,
  X,
} from "lucide-react";

interface Frontmatter {
  title?: string;
  description?: string;
}

interface Props extends MarkdownLayoutProps<Frontmatter> {}

const { frontmatter, headings = [] } = Astro.props;
const title = frontmatter?.title || "Evora Docs";
const description =
  frontmatter?.description ||
  "Portal de documentación oficial de Evora";
const currentPath = Astro.url.pathname;

const rawMainAppUrl =
  import.meta.env.PUBLIC_MAIN_APP_URL || "http://localhost:3000";
const mainAppUrl = rawMainAppUrl.endsWith("/") ? rawMainAppUrl.slice(0, -1) : rawMainAppUrl;

const rawDocsUrl =
  import.meta.env.PUBLIC_DOCS_URL ||
  (typeof Astro.url !== "undefined"
    ? `${Astro.url.protocol}//${Astro.url.host}`
    : "http://localhost:3001");
const docsPublicUrl = rawDocsUrl.endsWith("/") ? rawDocsUrl.slice(0, -1) : rawDocsUrl;

/** Cookie Domain compartido con el panel (vacío en localhost). */
function resolveThemeCookieDomain(appUrl: string, docsUrl: string): string {
  try {
    const appHost = new URL(appUrl).hostname;
    const docsHost = new URL(docsUrl).hostname;
    if (
      appHost === docsHost ||
      appHost === "localhost" ||
      docsHost === "localhost" ||
      appHost === "127.0.0.1" ||
      docsHost === "127.0.0.1"
    ) {
      return "";
    }
    const a = appHost.split(".").reverse();
    const b = docsHost.split(".").reverse();
    const common: string[] = [];
    for (let i = 0; i < Math.min(a.length, b.length); i++) {
      if (a[i] !== b[i]) break;
      common.push(a[i]);
    }
    if (common.length < 2) return "";
    return `.${common.reverse().join(".")}`;
  } catch {
    return "";
  }
}

const themeCookieDomain = resolveThemeCookieDomain(mainAppUrl, docsPublicUrl);

// Helper to check active nav link
const isActive = (path: string) => {
  const normCurrent = currentPath.replace(/\/$/, ""); // Remove trailing slash
  const docsPath = ("/docs" + (path === "/" ? "" : path)).replace(/\/$/, "");
  return (
    normCurrent === docsPath ||
    (path === "/" && (normCurrent === "/docs" || normCurrent === ""))
  );
};

interface NavItem {
  label: string;
  path: string;
  icon: any;
  requiredPermission?: string;
}

interface NavGroup {
  group: string;
  requiredPermission?: string;
  items: NavItem[];
}

const navigation: NavGroup[] = [
  {
    group: "Primeros Pasos",
    items: [{ label: "Introducción", path: "/", icon: BookOpen }],
  },
  {
    group: "Guías de Usuario",
    items: [
      { label: "Guía del Miembro", path: "/miembro", icon: User, requiredPermission: "docs:view:member" },
      { label: "Guía del Organizador", path: "/organizador", icon: Calendar, requiredPermission: "docs:view:organizer" },
      { label: "Guía del Administrador", path: "/admin", icon: Settings, requiredPermission: "docs:view:admin" },
      { label: "Preguntas Frecuentes", path: "/faq", icon: HelpCircle },
      { label: "Videotutoriales", path: "/videotutoriales", icon: Video },
    ],
  },
  {
    group: "Desarrolladores",
    requiredPermission: "docs:view:dev",
    items: [
      { label: "Arquitectura Técnica", path: "/arquitectura", icon: Cpu, requiredPermission: "docs:view:dev" },
      { label: "Setup Local", path: "/setup-local", icon: TerminalSquare, requiredPermission: "docs:view:dev" },
      { label: "Local vs Producción", path: "/datos-local-vs-produccion", icon: Database, requiredPermission: "docs:view:dev" },
      { label: "Despliegue", path: "/despliegue", icon: Rocket, requiredPermission: "docs:view:dev" },
      { label: "Staging pre-prod", path: "/staging-pre-prod", icon: Shield, requiredPermission: "docs:view:dev" },
      { label: "Operaciones", path: "/operaciones", icon: Shield, requiredPermission: "docs:view:dev" },
      { label: "Migraciones", path: "/migraciones", icon: History, requiredPermission: "docs:view:dev" },
      { label: "Inventario Módulos", path: "/inventario-modulos", icon: BookOpen, requiredPermission: "docs:view:dev" },
      { label: "Esquema de BD", path: "/base-de-datos", icon: Database, requiredPermission: "docs:view:dev" },
      { label: "Roles y Permisos", path: "/auth-roles", icon: Shield, requiredPermission: "docs:view:dev" },
      { label: "Tiempo Real (WS)", path: "/websockets", icon: Activity, requiredPermission: "docs:view:dev" },
    ],
  },
  {
    group: "Plataforma",
    items: [
      { label: "Registro de Cambios", path: "/changelog", icon: History },
      { label: "Soporte y Contacto", path: "/soporte", icon: LifeBuoy },
    ],
  },
];

/** Path -> permiso requerido. Sin entrada = visible a cualquier usuario autenticado. */
const pagePermissions: Record<string, string> = Object.fromEntries(
  navigation
    .flatMap((g) => g.items)
    .filter((item) => item.requiredPermission)
    .map((item) => [
      `/docs${item.path === "/" ? "" : item.path}`,
      item.requiredPermission as string,
    ]),
);

// Search Index Generation (after pagePermissions for RBAC filtering)
const allDocs = await Astro.glob('../pages/docs/*.md');
const searchIndex = allDocs.map(doc => {
  const url = doc.url?.replace(/\/$/, "") || "";
  return {
    title: doc.frontmatter.title || "Documentación",
    url,
    requiredPermission: pagePermissions[url] || "",
    headings: doc.getHeadings().map((h) => ({
      text: h.text,
      slug: h.slug,
    })),
  };
});

// Determine Next and Previous pages for the bottom navigation
const flatNav = navigation.flatMap((g) => g.items);
/** Serializable for client RBAC (no icons). */
const flatNavClient = flatNav.map((item) => ({
  label: item.label,
  path: item.path,
  requiredPermission: item.requiredPermission || "",
}));
const currentIndex = flatNav.findIndex((item) => isActive(item.path));
const prevPage = currentIndex > 0 ? flatNav[currentIndex - 1] : null;
const nextPage =
  currentIndex >= 0 && currentIndex < flatNav.length - 1
    ? flatNav[currentIndex + 1]
    : null;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} – Evora Docs</title>
    <ViewTransitions />

    <!-- Theme Script: cookie compartida con el panel (evora-theme) -->
    <script is:inline define:vars={{ themeCookieDomain }}>
      (function () {
        function readCookie(name) {
          var match = document.cookie.match(
            new RegExp("(?:^|;\\s*)" + name + "=([^;]*)"),
          );
          return match ? decodeURIComponent(match[1]) : null;
        }
        function writeCookie(name, value) {
          var maxAge = 60 * 60 * 24 * 365;
          var cookie =
            name +
            "=" +
            encodeURIComponent(value) +
            "; Path=/; Max-Age=" +
            maxAge +
            "; SameSite=Lax";
          if (themeCookieDomain) cookie += "; Domain=" + themeCookieDomain;
          if (location.protocol === "https:") cookie += "; Secure";
          document.cookie = cookie;
        }
        var fromCookie = readCookie("evora-theme");
        var fromStorage =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("theme")
            : null;
        var theme =
          fromCookie === "dark" || fromCookie === "light"
            ? fromCookie
            : fromStorage === "dark" || fromStorage === "light"
              ? fromStorage
              : "light";
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
        try {
          localStorage.setItem("theme", theme);
        } catch (e) {}
        writeCookie("evora-theme", theme);
        window.__evoraApplyTheme = function (next) {
          if (next !== "dark" && next !== "light") return;
          document.documentElement.classList.toggle("dark", next === "dark");
          try {
            localStorage.setItem("theme", next);
          } catch (e) {}
          writeCookie("evora-theme", next);
        };
      })();
    </script>
    <script define:vars={{ mainAppUrl, pagePermissions, flatNavClient }}>
      (function () {
        const flatNav = flatNavClient;
        const ROLE_LABELS = {
          super_admin: "Súper Admin",
          admin: "Administrador",
          organizer: "Organizador",
          member: "Miembro",
        };

        const ROLE_COLORS = {
          super_admin: "bg-[#15803d]",
          admin: "bg-[#cb6916]",
          organizer: "bg-[#2563eb]",
          member: "bg-[#57534e]",
        };

        function escapeHtml(value) {
          return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#39;");
        }

        function redirectToLogin() {
          const returnUrl = encodeURIComponent(window.location.href);
          window.location.href = `${mainAppUrl}/login?redirect=${returnUrl}`;
        }

        function currentDocsPath() {
          return (window.location.pathname || "/docs").replace(/\/$/, "") || "/docs";
        }

        function canAccessPath(path, permissions) {
          const required = pagePermissions[path];
          if (!required) return true;
          return permissions.includes(required);
        }

        function enforcePageAccess(permissions) {
          const path = currentDocsPath();
          if (!canAccessPath(path, permissions)) {
            window.location.replace("/docs");
            return false;
          }
          return true;
        }

        function renderProfile(user, role) {
          const profileDiv = document.getElementById("docs-user-profile");
          if (!profileDiv || !user) return;

          const normalizedRole = role || user.role || "member";
          const roleLabel = ROLE_LABELS[normalizedRole] || ROLE_LABELS.member;
          const roleColor = ROLE_COLORS[normalizedRole] || ROLE_COLORS.member;
          const name = escapeHtml(user.name || "Usuario");
          const email = escapeHtml(user.email || "");
          const initial = escapeHtml((user.name || "U").charAt(0).toUpperCase());
          const image = user.image ? escapeHtml(user.image) : "";

          profileDiv.innerHTML = `
            <div class="hidden sm:flex flex-col items-end mr-1 min-w-0">
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold text-foreground leading-tight max-w-[140px] truncate">${name}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold text-white shadow-sm ${roleColor}">${roleLabel}</span>
              </div>
              <span class="text-[10px] text-muted-foreground leading-none max-w-[180px] truncate mt-0.5">${email}</span>
            </div>
            <div title="${name} · ${roleLabel}" class="relative flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-foreground/15 bg-foreground/5 shadow-sm ring-2 ring-[#cb6916]/20">
              ${
                image
                  ? `<img src="${image}" alt="${name}" class="h-full w-full object-cover" />`
                  : `<span class="text-xs font-bold text-[#cb6916]">${initial}</span>`
              }
            </div>
          `;
          profileDiv.classList.remove("hidden");
          profileDiv.classList.add("flex");
        }

        function applyNavPermissions(permissions) {
          const userPermissions = new Set(permissions || []);

          document.querySelectorAll(".nav-item").forEach((el) => {
            const perm = el.getAttribute("data-permission");
            const gated = el.getAttribute("data-docs-gated") === "1";
            if (gated) {
              if (perm && userPermissions.has(perm)) {
                el.classList.add("docs-allowed");
              } else {
                el.classList.remove("docs-allowed");
              }
            }
          });

          document.querySelectorAll(".nav-group").forEach((el) => {
            const groupPerm = el.getAttribute("data-permission");
            const gated = el.getAttribute("data-docs-gated") === "1";

            if (gated) {
              if (groupPerm && userPermissions.has(groupPerm)) {
                el.classList.add("docs-allowed");
              } else {
                el.classList.remove("docs-allowed");
                return;
              }
            }

            const items = el.querySelectorAll(".nav-item");
            if (items.length > 0) {
              const visibleChildren = Array.from(items).some((child) => {
                const childGated = child.getAttribute("data-docs-gated") === "1";
                if (!childGated) return true;
                return child.classList.contains("docs-allowed");
              });
              if (!visibleChildren) {
                el.classList.remove("docs-allowed");
                el.setAttribute("data-docs-empty", "1");
              } else {
                el.removeAttribute("data-docs-empty");
                if (!gated) el.style.display = "";
              }
            }
          });

          document.querySelectorAll("[data-docs-perm]").forEach((el) => {
            const perm = el.getAttribute("data-docs-perm");
            if (perm && !userPermissions.has(perm)) {
              el.style.display = "none";
            } else {
              el.style.display = "";
            }
          });
        }

        function updateBottomNav(permissions) {
          const container = document.getElementById("docs-bottom-nav");
          if (!container || !Array.isArray(flatNav)) return;

          const visible = flatNav.filter((item) => {
            if (item.requiredPermission && !permissions.includes(item.requiredPermission)) {
              return false;
            }
            return true;
          });

          const current = currentDocsPath();
          const idx = visible.findIndex((item) => {
            const path = `/docs${item.path === "/" ? "" : item.path}`;
            return path === current;
          });

          const prev = idx > 0 ? visible[idx - 1] : null;
          const next =
            idx >= 0 && idx < visible.length - 1 ? visible[idx + 1] : null;

          const linkHtml = (page, side) => {
            if (!page) return `<div></div>`;
            const href = `/docs${page.path === "/" ? "" : page.path}`;
            const label = escapeHtml(page.label);
            if (side === "prev") {
              return `
                <a href="${href}" class="flex flex-col gap-1 px-4 py-3 rounded-xl border border-foreground/10 hover:border-[#cb6916] hover:bg-[#cb6916]/5 transition-all text-left max-w-[48%] group/prev">
                  <span class="text-[10px] uppercase tracking-wider text-foreground/45 font-bold select-none">Anterior</span>
                  <span class="text-sm font-semibold text-[#cb6916] flex items-center gap-1.5">← ${label}</span>
                </a>`;
            }
            return `
              <a href="${href}" class="flex flex-col gap-1 px-4 py-3 rounded-xl border border-foreground/10 hover:border-[#cb6916] hover:bg-[#cb6916]/5 transition-all text-right max-w-[48%] group/next ml-auto">
                <span class="text-[10px] uppercase tracking-wider text-foreground/45 font-bold select-none">Siguiente</span>
                <span class="text-sm font-semibold text-[#cb6916] flex items-center gap-1.5 justify-end">${label} →</span>
              </a>`;
          };

          if (!prev && !next) {
            container.style.display = "none";
            return;
          }

          container.style.display = "flex";
          container.innerHTML = `${linkHtml(prev, "prev")}${linkHtml(next, "next")}`;
        }

        async function initDocsSession() {
          const profileDiv = document.getElementById("docs-user-profile");
          if (profileDiv && profileDiv.dataset.loaded !== "1") {
            profileDiv.classList.remove("hidden");
            profileDiv.classList.add("flex");
            profileDiv.innerHTML = `
              <div class="h-9 w-28 rounded-lg bg-foreground/10 animate-pulse hidden sm:block"></div>
              <div class="h-9 w-9 rounded-xl bg-foreground/10 animate-pulse"></div>
            `;
          }

          try {
            const res = await fetch(`${mainAppUrl}/api/docs/auth`, {
              credentials: "include",
              headers: { Accept: "application/json" },
            });

            if (!res.ok) throw new Error("No autenticado");

            const data = await res.json();
            if (!data?.user || data.role === "guest") {
              throw new Error("No hay sesión activa");
            }

            const permissions = data.permissions || [];
            window.__docsPermissions = permissions;
            if (!enforcePageAccess(permissions)) return;

            renderProfile(data.user, data.role);
            applyNavPermissions(permissions);
            updateBottomNav(permissions);
            if (profileDiv) profileDiv.dataset.loaded = "1";
          } catch (e) {
            redirectToLogin();
          }
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initDocsSession);
        } else {
          initDocsSession();
        }
        document.addEventListener("astro:page-load", initDocsSession);
      })();
    </script>
  </head>
  <body
    class="bg-[#f6efe8] text-[#402410] dark:bg-[#120904] dark:text-[#f6efe8] min-h-screen flex flex-col font-sans antialiased"
  >
    <!-- Top Header Navigation Bar (docs.astro.build design) -->
    <header
      class="sticky top-0 z-40 w-full border-b border-foreground/8 bg-background/80 backdrop-blur-md bg-[#f6efe8]/90 dark:bg-[#120904]/90 transition-colors duration-300"
    >
      <div
        class="max-w-8xl mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8"
      >
        <!-- Left Section: Brand Logo -->
        <div class="flex items-center gap-3 sm:gap-4">
          <button
            id="mobile-menu-btn"
            class="lg:hidden flex h-9 w-9 items-center justify-center rounded-xl border border-foreground/15 bg-foreground/3 hover:bg-foreground/8 active:scale-95 transition-all text-[#cb6916]"
            aria-label="Abrir menú"
          >
            <Menu className="h-5 w-5" />
          </button>
          <a href="/docs" class="flex items-center gap-2.5 group">
            <div
              class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-white shadow-md transition-all group-hover:scale-105 active:scale-95 bg-[#cb6916]"
            >
              <Sparkles className="h-5 w-5 text-white" />
            </div>
            <span
              class="font-display text-lg font-bold tracking-tight text-foreground transition-opacity hover:opacity-90 flex items-center"
            >
              <span class="hidden sm:inline">Evora</span>
              <span
                class="text-[10px] sm:text-xs font-semibold bg-[#cb6916]/10 text-[#cb6916] border border-[#cb6916]/20 px-2 py-0.5 rounded-full ml-1"
                >Docs</span
              >
            </span>
          </a>
        </div>

        <!-- Middle Section: Simulated Search Box (Desktop Only) -->
        <div class="hidden lg:flex flex-1 max-w-md mx-8">
          <div
            id="search-btn"
            class="w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl border border-foreground/15 bg-foreground/3 text-muted-foreground/60 select-none cursor-pointer hover:bg-foreground/5 hover:border-foreground/20 transition-all"
          >
            <Search className="h-4.5 w-4.5 text-[#cb6916] shrink-0" />
            <span class="text-xs font-medium text-foreground/50 flex-1"
              >Buscar documentación...</span
            >
            <kbd
              class="hidden sm:inline-flex h-5 select-none items-center gap-0.5 rounded border border-foreground/20 bg-foreground/5 px-1.5 font-mono text-[10px] font-bold text-foreground/45"
            >
              <span class="text-[9px]">Ctrl</span>K
            </kbd>
          </div>
        </div>

        <!-- Right Section: Actions -->
        <div class="flex items-center gap-2 sm:gap-4">
          <!-- Mobile Search Button -->
          <button
            id="mobile-search-btn"
            class="lg:hidden flex h-9 w-9 items-center justify-center rounded-xl border border-foreground/15 bg-foreground/3 hover:bg-foreground/8 active:scale-95 transition-all text-[#cb6916]"
            aria-label="Buscar"
          >
            <Search className="h-4.5 w-4.5" />
          </button>

          <!-- Main App Link -->
          <a
            href={mainAppUrl}
            class="text-xs font-semibold bg-[#cb6916]/10 text-[#cb6916] border border-[#cb6916]/20 hover:bg-[#cb6916]/18 transition-all px-3 py-1.5 rounded-xl select-none flex items-center"
          >
            <span class="hidden sm:inline">Volver a la App</span>
            <span class="sm:hidden">App</span>
            <span class="ml-1">↗</span>
          </a>

          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-foreground/15 bg-foreground/3 hover:bg-foreground/8 hover:scale-105 active:scale-95 transition-all text-[#cb6916]"
            aria-label="Change theme"
          >
            <Sun className="h-5 w-5 hidden dark:block" />
            <Moon className="h-5 w-5 dark:hidden" />
          </button>
          
          <!-- User Profile Widget -->
          <div id="docs-user-profile" class="hidden items-center gap-2.5 border-l border-foreground/15 pl-4 ml-1">
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container Grid -->
    <div class="flex-1 w-full max-w-8xl mx-auto flex relative">
      <!-- Mobile Sidebar Overlay -->
      <div id="mobile-sidebar-overlay" class="fixed inset-0 z-40 bg-background/80 backdrop-blur-sm hidden lg:hidden transition-opacity opacity-0 duration-300"></div>

      <!-- Left Sidebar: Category Navigation -->
      <aside
        id="mobile-sidebar"
        class="fixed inset-y-0 left-0 z-50 flex w-72 shrink-0 -translate-x-full flex-col border-r border-foreground/10 bg-background transition-transform duration-300 lg:sticky lg:top-16 lg:z-0 lg:h-[calc(100dvh-4rem)] lg:translate-x-0 lg:inset-auto lg:left-auto lg:bg-foreground/[0.01]"
      >
        <!-- Mobile Header (Only visible on small screens inside sidebar) -->
        <div class="flex shrink-0 lg:hidden items-center justify-between p-4 border-b border-foreground/5">
          <span class="font-display font-bold text-foreground">Menú de Docs</span>
          <button id="close-mobile-menu" class="p-2 rounded-xl border border-foreground/15 bg-foreground/3 text-muted-foreground hover:text-foreground active:scale-95 transition-all">
            <X className="h-4 w-4" />
          </button>
        </div>

        <!-- Scrollable nav only (keeps header clear; last items reachable) -->
        <nav class="docs-sidebar-nav flex-1 overflow-y-auto overscroll-contain px-6 py-6 pb-20 lg:pl-4 lg:pr-6" aria-label="Documentación">
          <div class="space-y-6">
          {
            navigation.map((group) => (
              <div
                class="space-y-2 nav-group"
                data-permission={group.requiredPermission || undefined}
                data-docs-gated={group.requiredPermission ? "1" : undefined}
              >
                <h4 class="px-3 text-xs font-bold text-foreground/50 tracking-wider uppercase select-none">
                  {group.group}
                </h4>
                <ul class="space-y-1.5 border-l border-foreground/8 ml-3 pl-0">
                  {group.items.map((item) => {
                    const active = isActive(item.path);
                    const IconComponent = item.icon;
                    return (
                      <li
                        class="nav-item transition-all duration-300"
                        data-permission={item.requiredPermission || undefined}
                        data-docs-gated={item.requiredPermission ? "1" : undefined}
                      >
                        <a
                          href={`/docs${item.path === "/" ? "" : item.path}`}
                          class={`group flex items-center gap-2.5 pl-4 py-1.5 text-sm font-medium border-l-2 -ml-[1.5px] transition-all ${
                            active
                              ? "text-[#cb6916] border-[#cb6916] font-semibold bg-[#cb6916]/5 rounded-r-lg"
                              : "text-foreground/60 border-transparent hover:text-foreground hover:border-[#cb6916]/40"
                          }`}
                        >
                          <IconComponent
                            className={`h-4 w-4 shrink-0 transition-colors ${active ? "text-[#cb6916]" : "text-foreground/40 group-hover:text-[#cb6916]/80"}`}
                          />
                          {item.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
          </div>
        </nav>
      </aside>

      <!-- Center Article Column -->
      <main
