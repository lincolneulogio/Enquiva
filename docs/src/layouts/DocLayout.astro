    <script is:inline>
      (() => {
        let index = [];
        try {
          const raw = document.getElementById('search-data')?.textContent;
          if (raw) index = JSON.parse(raw);
        } catch(e){}

        const setupSearch = () => {
          const modal = document.getElementById('search-modal');
          const backdrop = document.getElementById('search-backdrop');
          const input = document.getElementById('search-input');
          const results = document.getElementById('search-results');
          const btn = document.getElementById('search-btn');
          const mobileBtn = document.getElementById('mobile-search-btn');

          if (!modal) return;

          const openModal = () => {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            // Allow layout to apply before animating opacity
            requestAnimationFrame(() => {
              modal.classList.remove('opacity-0');
              modal.classList.add('opacity-100');
              input.focus();
            });
            renderResults(input.value);
          };

          const closeModal = () => {
            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0');
            setTimeout(() => {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
            }, 200);
          };

          // Evitar registrar listeners duplicados con page-load de Astro
          if (btn) {
            const newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', openModal);
          }

          if (mobileBtn) {
            const newMobileBtn = mobileBtn.cloneNode(true);
            mobileBtn.parentNode.replaceChild(newMobileBtn, mobileBtn);
            newMobileBtn.addEventListener('click', openModal);
          }

          backdrop.addEventListener('click', closeModal);

          document.addEventListener('keydown', (e) => {
            if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
              e.preventDefault();
              openModal();
            }
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
              closeModal();
            }
          });

          const renderResults = (query) => {
            if (!query.trim()) {
              results.innerHTML = `<div class="text-center text-xs text-foreground/40 py-8">Comienza a escribir para buscar (ej: "Pago", "Autobús")...</div>`;
              return;
            }

            const q = query.toLowerCase();
            let html = '';
            let count = 0;

            index.forEach(page => {
              const required = page.requiredPermission;
              const allowed =
                !required ||
                (Array.isArray(window.__docsPermissions) &&
                  window.__docsPermissions.includes(required));
              if (!allowed) return;

              let pageMatched = page.title.toLowerCase().includes(q);
              const matchedHeadings = page.headings.filter(h => h.text.toLowerCase().includes(q));

              if (pageMatched || matchedHeadings.length > 0) {
                html += `<div class="text-[10px] font-bold uppercase tracking-wider text-foreground/40 mt-3 mb-1 px-2">${page.title}</div>`;
                
                if (pageMatched && matchedHeadings.length === 0) {
                   html += `<a href="${page.url}" class="block px-3 py-2 rounded-lg hover:bg-foreground/5 hover:text-[#cb6916] text-sm text-foreground/80 transition-colors">📄 Ver la guía completa</a>`;
                   count++;
                }

                matchedHeadings.forEach(h => {
                  html += `<a href="${page.url}#${h.slug}" class="block px-3 py-2 rounded-lg hover:bg-[#cb6916]/10 text-[#cb6916] text-sm font-medium transition-colors border-l-2 border-transparent hover:border-[#cb6916]"># ${h.text}</a>`;
                  count++;
                });
              }
            });

            if (count === 0) {
              results.innerHTML = `<div class="text-center text-sm text-foreground/60 py-8">No encontramos nada para "<span class="font-semibold text-[#cb6916]">${query}</span>"</div>`;
            } else {
              results.innerHTML = html;
              const links = results.querySelectorAll('a');
              links.forEach(l => l.addEventListener('click', closeModal));
            }
          };

          // Evitar listeners duplicados en input
          const newInput = input.cloneNode(true);
          input.parentNode.replaceChild(newInput, input);
          newInput.addEventListener('input', (e) => renderResults(e.target.value));
        };

        setupSearch();
        document.addEventListener('astro:page-load', setupSearch);
      })();
    </script>
    
    <!-- Client-side UI helpers (auth/RBAC viven en el script unificado del head) -->
    <script is:inline>
      // Mobile Menu Logic
      const initMobileMenu = () => {
        const btn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('close-mobile-menu');
        const sidebar = document.getElementById('mobile-sidebar');
        const overlay = document.getElementById('mobile-sidebar-overlay');
        
        const toggleMenu = (open) => {
          if (!sidebar || !overlay) return;
          if (open) {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            // Allow display block to apply before fading in
            setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            document.body.style.overflow = 'hidden'; // prevent scrolling behind
          } else {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('opacity-0');
            setTimeout(() => overlay.classList.add('hidden'), 300); // Wait for transition
            document.body.style.overflow = '';
          }
        };

        if (btn) btn.addEventListener('click', () => toggleMenu(true));
        if (closeBtn) closeBtn.addEventListener('click', () => toggleMenu(false));
        if (overlay) overlay.addEventListener('click', () => toggleMenu(false));
      };

      document.addEventListener('astro:page-load', initMobileMenu);
    </script>
  </body>
</html>

