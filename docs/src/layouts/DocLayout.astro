          </button>
        </div>

        <!-- Search Results Area -->
        <div class="max-h-[60vh] overflow-y-auto overscroll-contain">
          <ul id="search-results" class="p-2 space-y-1">
            <!-- Results injected here via JS -->
          </ul>
          
          <div id="search-empty" class="hidden flex-col items-center justify-center py-14 px-4 text-center">
            <!-- Placeholder icon using raw svg to avoid scope issues -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10 text-muted-foreground/30 mb-4"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <p class="text-sm font-medium text-foreground">No se encontraron resultados</p>
            <p class="text-xs text-muted-foreground mt-1">Prueba con otras palabras clave.</p>
          </div>
          
          <div id="search-default" class="flex flex-col items-center justify-center py-10 px-4 text-center">
            <p class="text-xs text-muted-foreground flex items-center gap-1.5">
              <span class="inline-flex items-center justify-center bg-[#cb6916] text-white rounded-full w-5 h-5 text-[10px]">✨</span>
              Búsqueda instantánea en todos los artículos
            </p>
          </div>
        </div>
      </div>
