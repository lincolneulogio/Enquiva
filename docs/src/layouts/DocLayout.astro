---
import { ViewTransitions } from "astro:transitions";
import type { MarkdownLayoutProps } from "astro";
import "../styles/global.css";
import {
  BookOpen,
  User,
  Calendar,
  Settings,
  Cpu,
  Sparkles,
  Search,
  Sun,
  Moon,
  ChevronLeft,
  ChevronRight,
  ChevronUp,
  HelpCircle,
  Video,
  Database,
  Shield,
  Activity,
  History,
  LifeBuoy,
  TerminalSquare,
  Menu,
  X,
} from "lucide-react";

interface Frontmatter {
  title?: string;
  description?: string;
}

interface Props extends MarkdownLayoutProps<Frontmatter> {}

const { frontmatter, headings = [] } = Astro.props;
const title = frontmatter?.title || "Eventia Docs";
const description =
  frontmatter?.description ||
  "Portal de documentación oficial de Eventia";
const currentPath = Astro.url.pathname;

const rawMainAppUrl =
  import.meta.env.PUBLIC_MAIN_APP_URL || "http://localhost:3000";
const mainAppUrl = rawMainAppUrl.endsWith("/") ? rawMainAppUrl.slice(0, -1) : rawMainAppUrl;

// Search Index Generation
const allDocs = await Astro.glob('../pages/docs/*.md');
const searchIndex = allDocs.map(doc => ({
  title: doc.frontmatter.title || 'Documentación',
  url: doc.url?.replace(/\/$/, '') || '',
  headings: doc.getHeadings().map((h) => ({
    text: h.text,
    slug: h.slug
  }))
}));

// Helper to check active nav link
const isActive = (path: string) => {
  const normCurrent = currentPath.replace(/\/$/, ""); // Remove trailing slash
  const docsPath = ("/docs" + (path === "/" ? "" : path)).replace(/\/$/, "");
  return (
    normCurrent === docsPath ||
    (path === "/" && (normCurrent === "/docs" || normCurrent === ""))
  );
};

interface NavItem {
  label: string;
  path: string;
  icon: any;
  requiredPermission?: string;
}

interface NavGroup {
  group: string;
  requiredPermission?: string;
  items: NavItem[];
}

const navigation: NavGroup[] = [
  {
    group: "Primeros Pasos",
    items: [{ label: "Introducción", path: "/", icon: BookOpen }],
  },
  {
    group: "Guías de Usuario",
    items: [
      { label: "Guía del Miembro", path: "/miembro", icon: User, requiredPermission: "docs:view:member" },
      { label: "Guía del Organizador", path: "/organizador", icon: Calendar, requiredPermission: "docs:view:organizer" },
      { label: "Guía del Administrador", path: "/admin", icon: Settings, requiredPermission: "docs:view:admin" },
      { label: "Preguntas Frecuentes", path: "/faq", icon: HelpCircle },
      { label: "Videotutoriales", path: "/videotutoriales", icon: Video },
    ],
  },
  {
    group: "Desarrolladores",
    requiredPermission: "docs:view:dev",
    items: [
      { label: "Arquitectura Técnica", path: "/arquitectura", icon: Cpu },
      { label: "Setup Local", path: "/setup-local", icon: TerminalSquare },
      { label: "Esquema de BD", path: "/base-de-datos", icon: Database },
      { label: "Roles y Permisos", path: "/auth-roles", icon: Shield },
      { label: "Tiempo Real (WS)", path: "/websockets", icon: Activity },
    ],
  },
  {
    group: "Plataforma",
    items: [
      { label: "Registro de Cambios", path: "/changelog", icon: History },
      { label: "Soporte y Contacto", path: "/soporte", icon: LifeBuoy },
    ],
  },
];

// Determine Next and Previous pages for the bottom navigation
const flatNav = navigation.flatMap((g) => g.items);
const currentIndex = flatNav.findIndex((item) => isActive(item.path));
const prevPage = currentIndex > 0 ? flatNav[currentIndex - 1] : null;
const nextPage =
  currentIndex >= 0 && currentIndex < flatNav.length - 1
    ? flatNav[currentIndex + 1]
    : null;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} – Eventia Docs</title>
    <ViewTransitions />

    <!-- Theme Script to prevent flash of wrong mode -->
    <script is:inline>
      const getTheme = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const theme = getTheme();
      if (theme === "dark") {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
      window.localStorage.setItem("theme", theme);
    </script>
    <script define:vars={{ mainAppUrl }}>
      async function checkAuth() {
        try {
          const res = await fetch(`${mainAppUrl}/api/auth/get-session`, {
            credentials: "include"
          });
          if (!res.ok) throw new Error("No autenticado");
          
          const data = await res.json();
          if (!data || !data.session) {
            throw new Error("No hay sesión activa");
          } else {
            // Mostrar avatar del usuario si se verificó correctamente
            const profileDiv = document.getElementById("docs-user-profile");
            if (profileDiv && data.user) {
              profileDiv.classList.remove("hidden");
              profileDiv.classList.add("flex");
              profileDiv.innerHTML = `
                <div title="${data.user.email}" class="h-8 w-8 shrink-0 rounded-full bg-[#cb6916] text-white flex items-center justify-center text-xs font-bold shadow-sm ring-2 ring-background">
                  ${data.user.name.charAt(0).toUpperCase()}
                </div>
              `;
            }
          }
        } catch (e) {
          window.location.href = `${mainAppUrl}/login?redirect=${encodeURIComponent(window.location.href)}`;
        }
      }
      checkAuth();
    </script>
  </head>
  <body
    class="bg-[#f6efe8] text-[#402410] dark:bg-[#120904] dark:text-[#f6efe8] min-h-screen flex flex-col font-sans antialiased"
  >
    <!-- Top Header Navigation Bar (docs.astro.build design) -->
    <header
      class="sticky top-0 z-40 w-full border-b border-foreground/8 bg-background/80 backdrop-blur-md bg-[#f6efe8]/90 dark:bg-[#120904]/90 transition-colors duration-300"
    >
      <div
        class="max-w-8xl mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8"
      >
        <!-- Left Section: Brand Logo -->
        <div class="flex items-center gap-3 sm:gap-4">
          <button
            id="mobile-menu-btn"
            class="lg:hidden flex h-9 w-9 items-center justify-center rounded-xl border border-foreground/15 bg-foreground/3 hover:bg-foreground/8 active:scale-95 transition-all text-[#cb6916]"
            aria-label="Abrir menú"
          >
            <Menu className="h-5 w-5" />
          </button>
          <a href="/docs" class="flex items-center gap-2.5 group">
            <div
              class="flex h-9 w-9 items-center justify-center rounded-xl bg-primary text-white shadow-md transition-all group-hover:scale-105 active:scale-95 bg-[#cb6916]"
            >
              <Sparkles className="h-5 w-5 text-white" />
            </div>
            <span
              class="font-display text-lg font-bold tracking-tight text-foreground transition-opacity hover:opacity-90 flex items-center"
            >
              <span class="hidden sm:inline">Eventia</span>
              <span
                class="text-[10px] sm:text-xs font-semibold bg-[#cb6916]/10 text-[#cb6916] border border-[#cb6916]/20 px-2 py-0.5 rounded-full ml-1"
                >Docs</span
              >
            </span>
          </a>
        </div>

        <!-- Middle Section: Simulated Search Box (Desktop Only) -->
        <div class="hidden lg:flex flex-1 max-w-md mx-8">
          <div
            id="search-btn"
            class="w-full flex items-center gap-2.5 px-3 py-1.5 rounded-xl border border-foreground/15 bg-foreground/3 text-muted-foreground/60 select-none cursor-pointer hover:bg-foreground/5 hover:border-foreground/20 transition-all"
          >
            <Search className="h-4.5 w-4.5 text-[#cb6916] shrink-0" />
            <span class="text-xs font-medium text-foreground/50 flex-1"
              >Buscar documentación...</span
            >
            <kbd
              class="hidden sm:inline-flex h-5 select-none items-center gap-0.5 rounded border border-foreground/20 bg-foreground/5 px-1.5 font-mono text-[10px] font-bold text-foreground/45"
            >
              <span class="text-[9px]">Ctrl</span>K
            </kbd>
          </div>
        </div>

        <!-- Right Section: Actions -->
        <div class="flex items-center gap-2 sm:gap-4">
          <!-- Mobile Search Button -->
          <button
            id="mobile-search-btn"
            class="lg:hidden flex h-9 w-9 items-center justify-center rounded-xl border border-foreground/15 bg-foreground/3 hover:bg-foreground/8 active:scale-95 transition-all text-[#cb6916]"
            aria-label="Buscar"
          >
            <Search className="h-4.5 w-4.5" />
          </button>

          <!-- Main App Link -->
          <a
            href={mainAppUrl}
            class="text-xs font-semibold bg-[#cb6916]/10 text-[#cb6916] border border-[#cb6916]/20 hover:bg-[#cb6916]/18 transition-all px-3 py-1.5 rounded-xl select-none flex items-center"
          >
            <span class="hidden sm:inline">Volver a la App</span>
            <span class="sm:hidden">App</span>
            <span class="ml-1">↗</span>
          </a>

          <!-- Theme Toggle Button -->
          <button
            id="theme-toggle"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-foreground/15 bg-foreground/3 hover:bg-foreground/8 hover:scale-105 active:scale-95 transition-all text-[#cb6916]"
            aria-label="Change theme"
          >
            <Sun className="h-5 w-5 hidden dark:block" />
            <Moon className="h-5 w-5 dark:hidden" />
          </button>
          
          <!-- User Profile Widget -->
          <div id="docs-user-profile" class="hidden items-center gap-2.5 border-l border-foreground/15 pl-4 ml-1">
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container Grid -->
    <div class="flex-1 w-full max-w-8xl mx-auto flex relative">
      <!-- Mobile Sidebar Overlay -->
      <div id="mobile-sidebar-overlay" class="fixed inset-0 z-40 bg-background/80 backdrop-blur-sm hidden lg:hidden transition-opacity opacity-0 duration-300"></div>

      <!-- Left Sidebar: Category Navigation -->
      <aside
        id="mobile-sidebar"
        class="fixed inset-y-0 left-0 z-50 w-72 shrink-0 border-r border-foreground/10 bg-background lg:bg-foreground/[0.01] transform -translate-x-full lg:translate-x-0 transition-transform duration-300 lg:sticky lg:top-16 lg:h-[calc(100vh-4rem)] lg:block overflow-y-auto"
      >
        <!-- Mobile Header (Only visible on small screens inside sidebar) -->
        <div class="flex lg:hidden items-center justify-between p-4 border-b border-foreground/5 mb-4">
          <span class="font-display font-bold text-foreground">Menú de Docs</span>
          <button id="close-mobile-menu" class="p-2 rounded-xl border border-foreground/15 bg-foreground/3 text-muted-foreground hover:text-foreground active:scale-95 transition-all">
            <X className="h-4 w-4" />
          </button>
        </div>

        <div class="space-y-6 lg:py-6 lg:pl-4 lg:pr-6 pb-12 px-6">
          {
            navigation.map((group) => (
              <div class="space-y-2 nav-group" data-permission={group.requiredPermission || ""}>
                <h4 class="px-3 text-xs font-bold text-foreground/50 tracking-wider uppercase select-none">
                  {group.group}
                </h4>
                <ul class="space-y-1.5 border-l border-foreground/8 ml-3 pl-0">
                  {group.items.map((item) => {
                    const active = isActive(item.path);
                    const IconComponent = item.icon;
                    return (
                      <li class="nav-item transition-all duration-300" data-permission={item.requiredPermission || ""}>
                        <a
                          href={`/docs${item.path === "/" ? "" : item.path}`}
                          class={`group flex items-center gap-2.5 pl-4 py-1.5 text-sm font-medium border-l-2 -ml-[1.5px] transition-all ${
                            active
                              ? "text-[#cb6916] border-[#cb6916] font-semibold bg-[#cb6916]/5 rounded-r-lg"
                              : "text-foreground/60 border-transparent hover:text-foreground hover:border-[#cb6916]/40"
                          }`}
                        >
                          <IconComponent
                            className={`h-4 w-4 shrink-0 transition-colors ${active ? "text-[#cb6916]" : "text-foreground/40 group-hover:text-[#cb6916]/80"}`}
                          />
                          {item.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </aside>

      <!-- Center Article Column -->
      <main
        class="flex-1 min-w-0 px-6 sm:px-10 lg:px-12 py-8 md:py-12 max-w-4xl mx-auto"
      >
        <article
          class="prose prose-stone dark:prose-invert max-w-none focus:outline-none"
        >
          <!-- Main Markdown/MDX content goes here -->
          <slot />
        </article>

        <!-- Bottom Navigation: Prev / Next buttons -->
        {
          (prevPage || nextPage) && (
            <div class="mt-12 pt-6 border-t border-foreground/8 flex items-center justify-between gap-4">
              {prevPage ? (
                <a
                  href={`/docs${prevPage.path === "/" ? "" : prevPage.path}`}
                  class="flex flex-col gap-1 px-4 py-3 rounded-xl border border-foreground/10 hover:border-[#cb6916] hover:bg-[#cb6916]/5 transition-all text-left max-w-[48%] group/prev"
                >
                  <span class="text-[10px] uppercase tracking-wider text-foreground/45 font-bold select-none">
                    Anterior
                  </span>
                  <span class="text-sm font-semibold text-[#cb6916] flex items-center gap-1.5">
                    <ChevronLeft className="h-4 w-4 shrink-0 transition-transform group-hover/prev:-translate-x-0.5" />
                    {prevPage.label}
                  </span>
                </a>
              ) : (
                <div />
              )}

              {nextPage ? (
                <a
                  href={`/docs${nextPage.path === "/" ? "" : nextPage.path}`}
                  class="flex flex-col gap-1 px-4 py-3 rounded-xl border border-foreground/10 hover:border-[#cb6916] hover:bg-[#cb6916]/5 transition-all text-right max-w-[48%] group/next"
                >
                  <span class="text-[10px] uppercase tracking-wider text-foreground/45 font-bold select-none">
                    Siguiente
                  </span>
                  <span class="text-sm font-semibold text-[#cb6916] flex items-center gap-1.5 justify-end">
                    {nextPage.label}
                    <ChevronRight className="h-4 w-4 shrink-0 transition-transform group-hover/next:translate-x-0.5" />
                  </span>
                </a>
              ) : (
                <div />
              )}
            </div>
          )
        }
      </main>

      <!-- Right Sidebar: Table of Contents & Helpers (docs.astro.build inspired) -->
      <aside
        class="hidden xl:block w-64 shrink-0 py-8 pl-6 pr-4 bg-foreground/[0.01] border-l border-foreground/5"
      >
        <div class="sticky top-24 space-y-6">
          {
            headings && headings.length > 0 && (
              <div class="space-y-2">
                <h4 class="text-xs font-bold text-foreground/50 tracking-wider uppercase select-none">
                  En esta página
                </h4>
                <ul class="space-y-2 text-xs font-medium border-l border-foreground/8 pl-0">
                  {headings
                    .filter((h) => h.depth <= 3)
                    .map((h) => (
                      <li class={`pl-${(h.depth - 1) * 3} -ml-[1px]`}>
                        <a
                          href={`#${h.slug}`}
                          class="toc-link block py-0.5 text-foreground/60 hover:text-[#cb6916] transition-colors border-l-2 border-transparent hover:border-[#cb6916]/40 pl-3 leading-relaxed rounded-r-lg"
                        >
                          {h.text}
                        </a>
                      </li>
                    ))}
                </ul>
              </div>
            )
          }


        </div>
      </aside>
    </div>

    <!-- Centered Luxury Page Footer -->
    <footer
      class="border-t border-foreground/8 bg-foreground/[0.02] py-6 text-center select-none transition-colors duration-300"
    >
      <div
        class="max-w-8xl mx-auto px-4 flex flex-col gap-1.5 text-xs text-foreground/60"
      >
        <span>
          © {new Date().getFullYear()}
          <strong class="text-[#cb6916] font-bold">Eventia</strong>.
          Gestión premium de eventos y transporte comunitario.
        </span>
        <span class="text-[10px] opacity-75 font-medium"
          >Construido con Astro, Tailwind CSS v4 y Lucide React.</span
        >
      </div>
    </footer>

    <!-- Theme Change Script -->
    <script is:inline>
      (() => {
        const setupThemeToggle = () => {
          const button = document.getElementById("theme-toggle");
          if (button) {
            // Remove old listeners to prevent double toggles
            const newButton = button.cloneNode(true);
            button.parentNode.replaceChild(newButton, button);

            newButton.addEventListener("click", () => {
              const element = document.documentElement;
              element.classList.toggle("dark");
              const isDark = element.classList.contains("dark");
              localStorage.setItem("theme", isDark ? "dark" : "light");
            });
          }
        };

        setupThemeToggle();
        // Support Astro view transitions or dynamic loads
        document.addEventListener("astro:page-load", setupThemeToggle);
      })();
    </script>

    <!-- ScrollSpy Script for Table of Contents -->
    <script is:inline>
      (() => {
        let scrollTimeout;
        const setupScrollSpy = () => {
          const links = document.querySelectorAll('.toc-link');
          if (links.length === 0) return;

          const headings = Array.from(document.querySelectorAll('article h1, article h2, article h3')).filter(h => h.id);
          
          const onScroll = () => {
            if (headings.length === 0) return;
            let current = headings[0].id;

            for (const h of headings) {
              const rect = h.getBoundingClientRect();
              // Ajustamos a 150px: margen perfecto considerando el scroll-margin-top
              if (rect.top <= 150) {
                current = h.id;
              }
            }

            // Force last heading if user scrolled to the absolute bottom
            if ((window.innerHeight + Math.round(window.scrollY)) >= document.documentElement.scrollHeight - 20) {
              current = headings[headings.length - 1].id;
            }

            // Scroll to Top Button Visibility Logic
            const scrollTopBtn = document.getElementById('scroll-to-top');
            if (scrollTopBtn) {
              if (window.scrollY > 400) {
                scrollTopBtn.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
                scrollTopBtn.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
              } else {
                scrollTopBtn.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
                scrollTopBtn.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
              }
            }

            links.forEach((link) => {
              const targetId = link.getAttribute('href').replace('#', '');
              // Usamos decodeURIComponent para evitar problemas con tildes en los slugs
              if (decodeURIComponent(targetId) === decodeURIComponent(current)) {
                // Active state
                link.classList.add('text-[#cb6916]', 'border-[#cb6916]', 'font-semibold', 'bg-[#cb6916]/5');
                link.classList.remove('text-foreground/60', 'border-transparent');
              } else {
                // Inactive state
                link.classList.remove('text-[#cb6916]', 'border-[#cb6916]', 'font-semibold', 'bg-[#cb6916]/5');
                link.classList.add('text-foreground/60', 'border-transparent');
              }
            });
          };

          window.addEventListener('scroll', () => {
             if (scrollTimeout) {
                window.cancelAnimationFrame(scrollTimeout);
             }
             scrollTimeout = window.requestAnimationFrame(onScroll);
          }, { passive: true });
          
          // Initial call
          setTimeout(onScroll, 100);

          // Scroll to Top Click Listener
          const scrollTopBtn = document.getElementById('scroll-to-top');
          if (scrollTopBtn) {
            const newBtn = scrollTopBtn.cloneNode(true);
            scrollTopBtn.parentNode.replaceChild(newBtn, scrollTopBtn);
            newBtn.addEventListener('click', () => {
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });
          }
        };

        setupScrollSpy();
        document.addEventListener('astro:page-load', setupScrollSpy);
      })();
    </script>

    <!-- Scroll to Top Button -->
    <button
      id="scroll-to-top"
      class="fixed bottom-6 right-6 md:bottom-10 md:right-10 z-50 flex h-10 w-10 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-[#cb6916] text-white shadow-xl shadow-[#cb6916]/20 transition-all duration-300 translate-y-16 opacity-0 hover:bg-[#b05a12] hover:scale-110 active:scale-95 focus:outline-none pointer-events-none"
      aria-label="Volver arriba"
    >
      <ChevronUp className="h-5 w-5 sm:h-6 sm:w-6" />
    </button>

    <!-- Search Data & Modal Logic -->
    <script id="search-data" type="application/json" set:html={JSON.stringify(searchIndex)}></script>

    <!-- Search Modal -->
    <div id="search-modal" class="fixed inset-0 z-50 hidden items-start justify-center pt-16 sm:pt-24 opacity-0 transition-opacity duration-200">
      <!-- Modal Backdrop -->
      <div
        id="search-backdrop"
        class="absolute inset-0 bg-background/80 backdrop-blur-sm"
      >
      </div>

      <!-- Modal Content -->
      <div
        class="relative mx-4 sm:mx-auto mt-20 sm:mt-24 w-full max-w-xl bg-background border border-foreground/20 dark:border-foreground/25 shadow-2xl rounded-2xl overflow-hidden"
      >
        <!-- Search Input Header -->
        <div class="flex items-center gap-3 px-4 py-3 border-b border-foreground/10 dark:border-foreground/15 bg-foreground/3">
          <Search className="h-5 w-5 text-muted-foreground shrink-0" />
          <input
            type="text"
            id="search-input"
            class="flex-1 bg-transparent border-none outline-none text-foreground placeholder:text-muted-foreground text-sm"
            placeholder="Buscar en la documentación... (ej. pagos, qr, roles)"
            autocomplete="off"
            spellcheck="false"
          />
          <button
            id="close-search"
            class="p-1 rounded-md text-muted-foreground hover:bg-foreground/5 hover:text-foreground transition-colors"
            aria-label="Cerrar búsqueda"
          >
            <kbd class="font-mono text-[10px] px-1.5 py-0.5 border border-foreground/20 dark:border-foreground/30 rounded shadow-sm bg-foreground/5 select-none">ESC</kbd>
          </button>
        </div>

        <!-- Search Results Area -->
        <div class="max-h-[60vh] overflow-y-auto overscroll-contain">
          <ul id="search-results" class="p-2 space-y-1">
            <!-- Results injected here via JS -->
          </ul>
          
          <div id="search-empty" class="hidden flex-col items-center justify-center py-14 px-4 text-center">
            <!-- Placeholder icon using raw svg to avoid scope issues -->
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-10 w-10 text-muted-foreground/30 mb-4"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <p class="text-sm font-medium text-foreground">No se encontraron resultados</p>
            <p class="text-xs text-muted-foreground mt-1">Prueba con otras palabras clave.</p>
          </div>
          
          <div id="search-default" class="flex flex-col items-center justify-center py-10 px-4 text-center">
            <p class="text-xs text-muted-foreground flex items-center gap-1.5">
              <span class="inline-flex items-center justify-center bg-[#cb6916] text-white rounded-full w-5 h-5 text-[10px]">✨</span>
              Búsqueda instantánea en todos los artículos
            </p>
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
      (() => {
        let index = [];
        try {
          const raw = document.getElementById('search-data')?.textContent;
          if (raw) index = JSON.parse(raw);
        } catch(e){}

        const setupSearch = () => {
          const modal = document.getElementById('search-modal');
          const backdrop = document.getElementById('search-backdrop');
          const input = document.getElementById('search-input');
          const results = document.getElementById('search-results');
          const btn = document.getElementById('search-btn');
          const mobileBtn = document.getElementById('mobile-search-btn');

          if (!modal) return;

          const openModal = () => {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            // Allow layout to apply before animating opacity
            requestAnimationFrame(() => {
              modal.classList.remove('opacity-0');
              modal.classList.add('opacity-100');
              input.focus();
            });
            renderResults(input.value);
          };

          const closeModal = () => {
            modal.classList.remove('opacity-100');
            modal.classList.add('opacity-0');
            setTimeout(() => {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
            }, 200);
          };

          // Evitar registrar listeners duplicados con page-load de Astro
          if (btn) {
            const newBtn = btn.cloneNode(true);
            btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', openModal);
          }

          if (mobileBtn) {
            const newMobileBtn = mobileBtn.cloneNode(true);
            mobileBtn.parentNode.replaceChild(newMobileBtn, mobileBtn);
            newMobileBtn.addEventListener('click', openModal);
          }

          backdrop.addEventListener('click', closeModal);

          document.addEventListener('keydown', (e) => {
            if (e.key === 'k' && (e.ctrlKey || e.metaKey)) {
              e.preventDefault();
              openModal();
            }
            if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
              closeModal();
            }
          });

          const renderResults = (query) => {
            if (!query.trim()) {
              results.innerHTML = `<div class="text-center text-xs text-foreground/40 py-8">Comienza a escribir para buscar (ej: "Pago", "Autobús")...</div>`;
              return;
            }

            const q = query.toLowerCase();
            let html = '';
            let count = 0;

            index.forEach(page => {
              let pageMatched = page.title.toLowerCase().includes(q);
              const matchedHeadings = page.headings.filter(h => h.text.toLowerCase().includes(q));

              if (pageMatched || matchedHeadings.length > 0) {
                html += `<div class="text-[10px] font-bold uppercase tracking-wider text-foreground/40 mt-3 mb-1 px-2">${page.title}</div>`;
                
                if (pageMatched && matchedHeadings.length === 0) {
                   html += `<a href="${page.url}" class="block px-3 py-2 rounded-lg hover:bg-foreground/5 hover:text-[#cb6916] text-sm text-foreground/80 transition-colors">📄 Ver la guía completa</a>`;
                   count++;
                }

                matchedHeadings.forEach(h => {
                  html += `<a href="${page.url}#${h.slug}" class="block px-3 py-2 rounded-lg hover:bg-[#cb6916]/10 text-[#cb6916] text-sm font-medium transition-colors border-l-2 border-transparent hover:border-[#cb6916]"># ${h.text}</a>`;
                  count++;
                });
              }
            });

            if (count === 0) {
              results.innerHTML = `<div class="text-center text-sm text-foreground/60 py-8">No encontramos nada para "<span class="font-semibold text-[#cb6916]">${query}</span>"</div>`;
            } else {
              results.innerHTML = html;
              const links = results.querySelectorAll('a');
              links.forEach(l => l.addEventListener('click', closeModal));
            }
          };

          // Evitar listeners duplicados en input
          const newInput = input.cloneNode(true);
          input.parentNode.replaceChild(newInput, input);
          newInput.addEventListener('input', (e) => renderResults(e.target.value));
        };

        setupSearch();
        document.addEventListener('astro:page-load', setupSearch);
      })();
    </script>
    
    <!-- Client-side RBAC Sync Script -->
    <script is:inline>
      const initDocsAuth = async () => {
        try {
          const rawMainAppUrl = window.location.hostname === 'localhost' 
              ? 'http://localhost:3000' 
              : 'https://' + window.location.hostname.replace('docs.', '');
          const mainAppUrl = rawMainAppUrl.endsWith('/') ? rawMainAppUrl.slice(0, -1) : rawMainAppUrl;
              
          const res = await fetch(`${mainAppUrl}/api/docs/auth`, { 
            credentials: 'include',
            headers: { 'Accept': 'application/json' }
          });
          
          if (res.ok) {
            const data = await res.json();
            const userPermissions = data.permissions || [];
            
            // 1. Hide nav-items
            document.querySelectorAll('.nav-item').forEach(el => {
              const perm = el.getAttribute('data-permission');
              if (perm && !userPermissions.includes(perm)) {
                el.style.display = 'none';
              }
            });

            // 2. Hide nav-groups
            document.querySelectorAll('.nav-group').forEach(el => {
              const groupPerm = el.getAttribute('data-permission');
              if (groupPerm && !userPermissions.includes(groupPerm)) {
                el.style.display = 'none';
              } else {
                const items = el.querySelectorAll('.nav-item');
                if (items.length > 0) {
                  const visibleChildren = Array.from(items).some(child => child.style.display !== 'none');
                  if (!visibleChildren) el.style.display = 'none';
                }
              }
            });

            // 3. Render User Profile Widget
            const profileContainer = document.getElementById('docs-user-profile');
            if (profileContainer && data.user) {
              const user = data.user;
              const roleColor = user.role === 'super_admin' ? 'bg-[#15803d]' : user.role === 'admin' ? 'bg-[#cb6916]' : 'bg-[#2563eb]';
              const roleDisplay = user.role === 'super_admin' ? 'Súper Admin' : user.role === 'admin' ? 'Administrador' : user.role === 'organizer' ? 'Organizador' : 'Miembro';
              
              profileContainer.innerHTML = `
                <span class="hidden lg:flex mr-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold text-white shadow-sm items-center ${roleColor}">${roleDisplay}</span>
                <div class="hidden md:flex flex-col text-right ml-1">
                  <span class="text-xs font-bold text-foreground leading-tight max-w-[120px] truncate">${user.name || 'Usuario'}</span>
                  <span class="text-[10px] text-muted-foreground leading-none max-w-[120px] truncate mt-0.5">${user.email || ''}</span>
                </div>
                <div class="relative flex h-8 w-8 shrink-0 items-center justify-center overflow-hidden rounded-xl border border-foreground/15 bg-foreground/5 shadow-sm">
                  ${user.image 
                    ? `<img src="${user.image}" alt="${user.name}" class="h-full w-full object-cover" />` 
                    : `<span class="text-xs font-bold text-[#cb6916]">${(user.name || 'U').charAt(0).toUpperCase()}</span>`
                  }
                </div>
              `;
              profileContainer.classList.remove('hidden');
              profileContainer.classList.add('flex');
            }
          }
        } catch(e) {
          console.warn("RBAC Docs Sync failed. Silently ignoring.", e);
        }
      };

      document.addEventListener('astro:page-load', initDocsAuth);

      // Mobile Menu Logic
      const initMobileMenu = () => {
        const btn = document.getElementById('mobile-menu-btn');
        const closeBtn = document.getElementById('close-mobile-menu');
        const sidebar = document.getElementById('mobile-sidebar');
        const overlay = document.getElementById('mobile-sidebar-overlay');
        
        const toggleMenu = (open) => {
          if (!sidebar || !overlay) return;
          if (open) {
            sidebar.classList.remove('-translate-x-full');
            overlay.classList.remove('hidden');
            // Allow display block to apply before fading in
            setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            document.body.style.overflow = 'hidden'; // prevent scrolling behind
          } else {
            sidebar.classList.add('-translate-x-full');
            overlay.classList.add('opacity-0');
            setTimeout(() => overlay.classList.add('hidden'), 300); // Wait for transition
            document.body.style.overflow = '';
          }
        };

        if (btn) btn.addEventListener('click', () => toggleMenu(true));
        if (closeBtn) closeBtn.addEventListener('click', () => toggleMenu(false));
        if (overlay) overlay.addEventListener('click', () => toggleMenu(false));
      };

      document.addEventListener('astro:page-load', initMobileMenu);
    </script>
  </body>
</html>

