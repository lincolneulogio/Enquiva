{
  "name": "Evora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fast": "next dev --turbopack",
    "dev:poll": "cross-env WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 next dev",
    "dev:clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "npx tsx --env-file=.env ./scripts/reset-db.ts",
    "db:backup": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/backup-database.ts",
    "db:migrate:payment-methods": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/migrate-payment-methods-scope.ts",
    "db:migrate:categories-org": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/migrate-categories-organization.ts",
