    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
