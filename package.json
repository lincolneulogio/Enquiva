{
  "name": "faithevents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:fast": "next dev --turbopack",
    "dev:poll": "cross-env WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 next dev --turbopack",
    "dev:clean": "rm -rf .next",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:roles": "node --env-file=.env ./scripts/seed-roles.mjs",
    "db:seed:admin": "npx tsx --env-file=.env --tsconfig tsconfig.json ./scripts/seed-admin.ts",
    "db:add-indexes": "node --env-file=.env ./scripts/add-unique-indexes.mjs",
    "db:backfill:pending-payments": "node --env-file=.env ./scripts/backfill-pending-payments.mjs",
    "db:setup:categories": "node --env-file=.env ./scripts/add-categories-table.mjs",
    "db:add-role-permissions": "node --env-file=.env ./scripts/add-role-permissions-table.mjs",
    "db:setup:transport": "node --env-file=.env ./scripts/add-transport-tables.mjs",
    "db:setup:phones": "node --env-file=.env ./scripts/add-phone-columns.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.22",
