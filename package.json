{
  "name": "Enquiva",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fast": "next dev --turbopack",
    "dev:poll": "cross-env WATCHPACK_POLLING=true WATCHPACK_POLLING_INTERVAL=1000 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "doctor": "npx react-doctor@latest",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:critical": "playwright test e2e/critical-flow.spec.ts --project=critical",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "npx tsx --env-file=.env ./scripts/reset-db.ts",
    "db:seed:bootstrap": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/seed-bootstrap.ts",
    "db:fresh": "pnpm run db:reset && pnpm exec drizzle-kit push --force && pnpm run db:seed:bootstrap",
    "db:sync:plans": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/ensure-default-plans.ts",
    "db:backup": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/backup-database.ts",
    "jobs:subscriptions": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/process-subscription-lifecycle.ts",
    "seed:staging": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/seed-staging-flow.ts",
    "smoke:critical": "node --require ./scripts/shims/register-server-only.cjs --import tsx --env-file=.env ./scripts/smoke-critical-flow.ts",
    "staging:gate": "pnpm run seed:staging && pnpm run smoke:critical"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.66",
    "@ai-sdk/react": "^1.1.20",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@uploadthing/react": "^7.3.3",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "ai": "^6.0.192",
    "aos": "^2.3.4",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.23",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.7",
    "postgres": "^3.4.9",
    "pusher": "^5.3.3",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "sweetalert2": "^11.26.24",
    "tailwind-merge": "^3.6.0",
    "uploadthing": "^7.7.4",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.15",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@11.12.0+sha512.820a6fbd0d9f04c226638002aead1e45340a9139dd5dc077c1d83ef44aa2481c8eb6637b4c9aa696a3c7e35ba818e49cf27213e5f2b91138d09b7a3e26e898ba"
}
