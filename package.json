    "db:migrate:subscriptions-organization": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/migrate-subscriptions-organization.ts",
    "db:migrate:organization-member-status": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/migrate-organization-member-status.ts",
    "db:migrate:notification-types": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/migrate-notification-types.ts",
    "db:cleanup:orphan-guests": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/cleanup-orphan-guest-users.ts",
    "jobs:subscriptions": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/process-subscription-lifecycle.ts",
    "db:sync:event-categories": "npx tsx --env-file=.env --tsconfig tsconfig.json ./scripts/sync-event-categories.ts",
    "db:add-indexes": "node --env-file=.env ./scripts/add-unique-indexes.mjs",
    "db:backfill:pending-payments": "node --env-file=.env ./scripts/backfill-pending-payments.mjs",
    "db:setup:categories": "node --env-file=.env ./scripts/add-categories-table.mjs",
    "db:add-role-permissions": "node --env-file=.env ./scripts/add-role-permissions-table.mjs",
    "db:setup:transport": "node --env-file=.env ./scripts/add-transport-tables.mjs",
    "db:setup:phones": "node --env-file=.env ./scripts/add-phone-columns.mjs",
    "doctor": "npx react-doctor@latest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "vitest run && pnpm run test:e2e",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:ai": "tsx --env-file=.env ./scripts/test-ai-providers.ts",
    "test:uploadthing": "tsx --env-file=.env --tsconfig tsconfig.json ./scripts/test-uploadthing.ts",
    "test:redis": "tsx --env-file=.env ./scripts/test-redis.ts",
    "generate:brand": "tsx scripts/generate-brand-assets.ts",
    "setup:local": "pnpm run db:push"
